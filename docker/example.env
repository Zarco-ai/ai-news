# Copy to docker/.env before starting Postgres:
#   cp example.env .env
#
# Then from the docker/ directory:
#   docker compose up -d
#
# All of the bellow information can be put into 'TablePlus' to set up the connection of our postgresql db inside.

POSTGRES_USER=ai_news
POSTGRES_PASSWORD=ai_news_dev_password
POSTGRES_DB=ai_news
POSTGRES_PORT=5432

# Used by the Python app (copy to project root .env or export locally)
DATABASE_URL=postgresql+psycopg://ai_news:ai_news_dev_password@localhost:5432/ai_news
