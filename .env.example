# Copy to .env for local development and fill in real values.
# In production (Render), set these in the dashboard / render.yaml instead.

# --- Meta WhatsApp Cloud API ---
# Use a permanent System User token in production (the temp token expires in 24h).
ACCESS_TOKEN=""
APP_ID=""
APP_SECRET=""
PHONE_NUMBER_ID=""
VERIFY_TOKEN=""
VERSION="v18.0"
RECIPIENT_WAID=""

# --- OpenAI ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Budget controls ---
# Hard global cap (USD). Kept under the $5 of credit to leave margin.
GLOBAL_SPEND_CAP_USD="4.50"
# Max OpenAI-answered messages per user per UTC day.
PER_USER_DAILY_LIMIT="20"
# Price per 1M tokens (USD). Defaults approximate gpt-4o-mini; verify pricing.
INPUT_COST_PER_1M="0.15"
OUTPUT_COST_PER_1M="0.60"

# --- Database ---
# Local dev points at the Docker Postgres. On Render this is injected and may
# arrive as postgres://... (normalized automatically by app/db/config.py).
DATABASE_URL="postgresql+psycopg://ai_news:ai_news_dev_password@localhost:5432/ai_news"

# Set to "production" on the host so a missing DATABASE_URL fails loudly.
ENV="development"
